  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components content context hooks lib jobs tests --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",

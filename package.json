    "data:github": "node --env-file-if-exists=.env.local --import tsx jobs/refresh-github.ts",
    "data:status": "node --env-file-if-exists=.env.local --import tsx jobs/check-services.ts",
    "assets:prepare": "tsx jobs/prepare-assets.ts",
    "assets:logos": "tsx jobs/prepare-logos.ts",
    "assets:tools": "tsx jobs/prepare-tool-logos.ts",
    "assets:icons": "tsx jobs/prepare-site-icons.ts",
    "assets:trip": "tsx jobs/prepare-trip-media.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "devicon": "2.17.0",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
